# Normaliza saltos de linea: en el repo siempre LF, en checkout segun el SO.
* text=auto

# Archivos de texto que siempre deben ir con LF
*.java   text eol=lf
*.xml    text eol=lf
*.properties text eol=lf
*.md     text eol=lf

# Binarios: que git no intente convertirlos
*.jks    binary
*.jar    binary
*.war    binary
*.png    binary
*.jpg    binary
